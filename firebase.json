{
  "hosting": {
    "predeploy": [
      "npm run build"
    ],
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/200.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|svg|gif|ico|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(woff2|woff|otf|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/merchant-feed.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/w/boarding/**",
        "function": "boardingChatRedirect"
      },
      {
        "source": "/shop/product/**",
        "function": "shopProductRedirect"
      },
      {
        "source": "/shop",
        "destination": "/200.html"
      },
      {
        "source": "/shop/**",
        "destination": "/200.html"
      },
      {
        "source": "/delete-account",
        "destination": "/200.html"
      },
      {
        "source": "/delete-account/**",
        "destination": "/200.html"
      },
      {
        "source": "/forgot-password",
        "destination": "/200.html"
      },
      {
        "source": "/forgot-password/**",
        "destination": "/200.html"
      },
      {
        "source": "/reset-password",
        "destination": "/200.html"
      },
      {
        "source": "/reset-password/**",
        "destination": "/200.html"
      },
      {
        "source": "/login/**",
        "destination": "/200.html"
      },
      {
        "source": "/login",
        "destination": "/200.html"
      },
      {
        "source": "/account",
        "destination": "/200.html"
      },
      {
        "source": "/account/**",
        "destination": "/200.html"
      },
      {
        "source": "/cart",
        "destination": "/200.html"
      },
      {
        "source": "/cart/**",
        "destination": "/200.html"
      },
      {
        "source": "/checkout",
        "destination": "/200.html"
      },
      {
        "source": "/checkout/**",
        "destination": "/200.html"
      },
      {
        "source": "/orders",
        "destination": "/200.html"
      },
      {
        "source": "/orders/**",
        "destination": "/200.html"
      },
      {
        "source": "/payment",
        "destination": "/200.html"
      },
      {
        "source": "/payment/**",
        "destination": "/200.html"
      },
      {
        "source": "/events",
        "destination": "/200.html"
      },
      {
        "source": "/events/**",
        "destination": "/200.html"
      },
      {
        "source": "/organizer",
        "destination": "/200.html"
      },
      {
        "source": "/organizer/**",
        "destination": "/200.html"
      },
      {
        "source": "/download",
        "destination": "/200.html"
      },
      {
        "source": "/download/**",
        "destination": "/200.html"
      },
      {
        "source": "/shipping-and-returns",
        "destination": "/200.html"
      },
      {
        "source": "/shipping-and-returns/**",
        "destination": "/200.html"
      },
      {
        "source": "/terms",
        "destination": "/200.html"
      },
      {
        "source": "/terms/**",
        "destination": "/200.html"
      },
      {
        "source": "/privacy",
        "destination": "/200.html"
      },
      {
        "source": "/privacy/**",
        "destination": "/200.html"
      }
    ]
  }
}
